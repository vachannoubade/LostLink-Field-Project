# LostLink public browser configuration
#
# Only the approved VITE_ public values listed below are injected by
# vite.config.ts. Do not put
# service-role keys, secret keys, database passwords, or other server credentials
# in this file or in any VITE_ variable.
#
# Local development: copy this file to .env.local and fill in the values.
# Vercel: add the same names under Project Settings > Environment Variables for
# Production, Preview, and Development, then redeploy.
#
# Use VITE_SUPABASE_ANON_KEY, or the newer VITE_SUPABASE_PUBLISHABLE_KEY instead.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
