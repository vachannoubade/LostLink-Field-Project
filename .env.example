# ============================================================================
# LostLink Authentication & Database Configuration
# ============================================================================
# Option A (Production / Vercel): Configure your Supabase Project URL and Anon Key.
# Only use the public ANON key here — NEVER put your service_role secret key in VITE_* variables!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Option B (Localhost Development Server):
# When VITE_SUPABASE_URL is not set, the Vite backend server automatically
# serves a real cryptographic Node.js Auth API at /api/auth/* using scrypt + HMAC-SHA256 JWTs.
AUTH_SECRET=replace-with-a-random-32-byte-secret-in-production
